# Optional. Without a key, Brain answers from the built-in enology rules.
ANTHROPIC_API_KEY=

# Optional. Which Claude model Brain uses.
HB_MODEL=claude-sonnet-5

# Optional. API port, and HOST=0.0.0.0 to reach it from your phone on the same Wi-Fi (no login: trusted networks only).
PORT=8787
HOST=127.0.0.1

# Optional. The app answers to localhost, IP addresses and *.local names. Add any other names you
# reach it by, comma-separated, such as a Tailscale machine name.
HB_ALLOWED_HOSTS=

# Optional. Where the database lives. Defaults to data/harvest-brain.db; backups go in a backups/ folder beside it.
# HB_DB=/path/to/harvest-brain.db
