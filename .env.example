# Optional. Without a key, Brain answers from the built-in enology rules.
ANTHROPIC_API_KEY=

# Optional. Which Claude model Brain uses.
HB_MODEL=claude-sonnet-5

# Optional. API port, and HOST=0.0.0.0 to reach it from your phone on the same Wi-Fi (no login: trusted networks only).
PORT=8787
HOST=127.0.0.1
